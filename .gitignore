# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never enter the repo (§8).
# .env.example is the sole exception: it documents required keys with no values.
.env*
!.env.example

# vercel
.vercel

# supabase local artifacts / linked project state
.supabase/
supabase/.temp/

# editor
.vscode/
.idea/

# typescript
*.tsbuildinfo
next-env.d.ts
design-references/
.screenshots/
scripts/out/
