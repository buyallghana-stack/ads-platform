# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env.local (see .gitignore).
# Values here are documentation only — no real secrets in this file.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project URL and publishable key are safe to expose to the browser; they are
# protected by Row Level Security, which is why every table MUST have policies.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Server-only. Bypasses RLS entirely — treat as a root password.
# Never prefix with NEXT_PUBLIC_, never import into a client component.
# Dashboard > Project Settings > API Keys > secret key.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Feature flags (§2.3) -------------------------------------------------
# Master switch for real money leaving the platform. Stays "false" until the
# operator confirms the money-service licence. Redemption requests are still
# accepted and queued when off — only disbursement is blocked.
PAYOUTS_ENABLED=false

# Ghana-only geo-restriction (§6.9). Disable locally so development works
# from anywhere; MUST be true in production.
GEO_RESTRICTION_ENABLED=false

# --- Third-party (added as each module lands) -----------------------------
# Cloudflare Turnstile — CAPTCHA at signup and redemption (§7)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Resend — transactional email (verification / OTP)
# RESEND_API_KEY=

# Sentry — error monitoring (§8 observability)
# NEXT_PUBLIC_SENTRY_DSN=

# Korapay — mobile money payouts + subscription payments. License-gated.
# KORAPAY_PUBLIC_KEY=
# KORAPAY_SECRET_KEY=

# Crypto gateway — operator's own separate service. License-gated.
# CRYPTO_GATEWAY_BASE_URL=
# CRYPTO_GATEWAY_API_KEY=
